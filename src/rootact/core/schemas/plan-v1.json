{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rootact.dev/schemas/plan-v1.json",
  "title": "RACT Plan v1",
  "description": "Versioned plan schema for the Root Agentic Coding Tool.",
  "type": "object",
  "required": ["schema_version", "assumption", "confidence", "steps"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "0.9.0"],
      "description": "Semver plan schema version."
    },
    "assumption": {
      "type": "string",
      "minLength": 1,
      "description": "Load-bearing assumption justifying the plan."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Plan confidence between 0 and 1."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/definitions/milestone" }
    },
    "budget": {
      "$ref": "#/definitions/budget"
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["step_id", "action"],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "provider_hint": {
          "type": "string",
          "default": ""
        },
        "expected_artifact": {
          "type": "string",
          "default": ""
        },
        "tier": {
          "type": "string",
          "enum": ["T0", "T1", "T2", "T3"],
          "default": "T1"
        },
        "assumption_ids": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "parent_step_ids": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "tool_call": {
          "type": ["object", "null"]
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "description", "acceptance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "verifier_kind": {
          "type": "string",
          "enum": ["heuristic", "test", "assertion", "artifact", "provider"],
          "default": "heuristic"
        },
        "verifier_config": {
          "type": "object",
          "default": {}
        },
        "status": {
          "type": "string",
          "enum": ["open", "done", "blocked"],
          "default": "open"
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 300.0
        },
        "step_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60.0
        }
      }
    }
  }
}
